 extern "C" __EXPORT int px4_mavlink_debug_main(int argc, char *argv[]);
 
+#if defined(CONFIG_ARCH_BOARD_PX4_SITL)
+/** Explicit finite SITL test mode. Never overwrite a physical sensor or run twice. */
+static int run_hygrometer(int argc, char *argv[])
+{
+	constexpr unsigned sample_period_us = 100000; // 10 Hz
+	constexpr unsigned default_samples = 600; // one minute, opt-in only
+	constexpr unsigned max_samples = 36000; // at most one hour
+	constexpr float cycle_seconds = 60.f;
+	constexpr float two_pi = 6.2831853071795864769f;
+	static px4::atomic<bool> running{false};
+	unsigned samples = default_samples;
+
+	if (argc > 2) {
+		char *end = nullptr;
+		const long requested_samples = strtol(argv[2], &end, 10);
+
+		if (*argv[2] == '\0' || *end != '\0' || requested_samples < 1 || requested_samples > max_samples) {
+			PX4_ERR("hygrometer sample count must be 1..%u", max_samples);
+			return 1;
+		}
+
+		samples = static_cast<unsigned>(requested_samples);
+	}
+
+	bool expected = false;
+
+	if (!running.compare_exchange(&expected, true)) {
+		PX4_ERR("synthetic hygrometer is already running");
+		return 1;
+	}
+
+	sensor_hygrometer_s measurement{};
+	measurement.device_id = 0x7f000001u; // test identity, not transmitted by SENS_ATMOS
+	measurement.temperature = 20.f;
+	measurement.humidity = 40.f;
+	measurement.timestamp_sample = hrt_absolute_time();
+	measurement.timestamp = measurement.timestamp_sample;
+	int instance = 0;
+	orb_advert_t publisher = orb_advertise_multi(ORB_ID(sensor_hygrometer), &measurement, &instance);
+
+	if (!publisher || instance != 0) {
+		if (publisher) {
+			orb_unadvertise(publisher);
+		}
+
+		running.store(false);
+		PX4_ERR("hygrometer instance zero is unavailable");
+		return 1;
+	}
+
+	PX4_INFO("synthetic hygrometer 0: 10 Hz, %u samples", samples);
+	const uint64_t start = hrt_absolute_time();
+	uint64_t next_sample = start;
+
+	for (unsigned sample = 0; sample < samples; sample++) {
+		const uint64_t sample_time = hrt_absolute_time();
+		const float elapsed_seconds = (sample_time - start) * 1.e-6f;
+		const float signal = sinf(two_pi * elapsed_seconds / cycle_seconds);
+		measurement.timestamp_sample = sample_time;
+		measurement.temperature = 20.f + 2.f * signal;
+		measurement.humidity = 40.f + 5.f * signal;
+		measurement.timestamp = hrt_absolute_time();
+		orb_publish(ORB_ID(sensor_hygrometer), publisher, &measurement);
+		next_sample += sample_period_us;
+		const uint64_t now = hrt_absolute_time();
+
+		if (next_sample > now) {
+			px4_usleep(next_sample - now);
+
+		} else {
+			// Skip missed deadlines instead of sending catch-up bursts.
+			next_sample = now;
+		}
+	}
+
+	orb_unadvertise(publisher);
+	running.store(false);
+	PX4_INFO("synthetic hygrometer finished");
+	return 0;
+}
+#endif // CONFIG_ARCH_BOARD_PX4_SITL
+
 int px4_mavlink_debug_main(int argc, char *argv[])
 {
+	if (argc > 1 && strcmp(argv[1], "hygrometer") == 0) {
+#if defined(CONFIG_ARCH_BOARD_PX4_SITL)
+		return run_hygrometer(argc, argv);
+#else
+		PX4_ERR("synthetic hygrometer is SITL-only");
+		return 1;
+#endif
+	}
+
 	printf("Hello Debug!\n");
 
 	/* advertise named debug value */
