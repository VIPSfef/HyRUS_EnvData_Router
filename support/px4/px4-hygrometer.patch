 #include <uORB/topics/debug_value.h>
 #include <uORB/topics/debug_vect.h>
 #include <uORB/topics/debug_array.h>
+#include <uORB/topics/sensor_hygrometer.h>
 
 extern "C" __EXPORT int px4_mavlink_debug_main(int argc, char *argv[]);
 
+/** Explicit SITL-only test mode: two independent, deterministic hygrometers at 10 Hz. */
+static int run_hygrometer(int argc, char *argv[])
+{
+	constexpr unsigned sample_period_us = 100000; // 10 Hz, shared by the two sensors
+	constexpr unsigned default_samples = 600; // one minute, never starts automatically
+	constexpr unsigned max_samples = 36000; // bound an accidental invocation to one hour
+	constexpr unsigned simulated_sensor_count = 2;
+	constexpr float cycle_seconds = 60.f;
+	constexpr float two_pi = 6.2831853071795864769f;
+	unsigned samples = default_samples;
+
+	if (argc > 2) {
+		char *end = nullptr;
+		const long requested_samples = strtol(argv[2], &end, 10);
+
+		if (*argv[2] == '\0' || *end != '\0' || requested_samples < 1 || requested_samples > max_samples) {
+			PX4_ERR("hygrometer sample count must be 1..%u", max_samples);
+			return 1;
+		}
+
+		samples = static_cast<unsigned>(requested_samples);
+	}
+
+	orb_advert_t publishers[simulated_sensor_count] {};
+	int instances[simulated_sensor_count] {};
+	sensor_hygrometer_s measurements[simulated_sensor_count] {};
+
+	for (unsigned sensor = 0; sensor < simulated_sensor_count; sensor++) {
+		measurements[sensor].device_id = 0x7f000001u + sensor; // reserved test identities
+		measurements[sensor].temperature = 20.f + 10.f * sensor;
+		measurements[sensor].humidity = 40.f + 20.f * sensor;
+		measurements[sensor].timestamp_sample = hrt_absolute_time();
+		measurements[sensor].timestamp = measurements[sensor].timestamp_sample;
+		measurements[sensor].time_uncertainty_us = 1; // synthetic acquisition uses this exact PX4 clock tick
+		publishers[sensor] = orb_advertise_multi(ORB_ID(sensor_hygrometer), &measurements[sensor], &instances[sensor]);
+
+		if (!publishers[sensor]) {
+			PX4_ERR("failed to advertise hygrometer %u", sensor);
+
+			for (unsigned previous = 0; previous < sensor; previous++) {
+				orb_unadvertise(publishers[previous]);
+			}
+
+			return 1;
+		}
+	}
+
+	PX4_INFO("synthetic hygrometers %d/%d: 10 Hz, %u samples each", instances[0], instances[1], samples);
+	const uint64_t start = hrt_absolute_time();
+	uint64_t next_sample = start;
+
+	for (unsigned sample = 0; sample < samples; sample++) {
+		const uint64_t sample_time = hrt_absolute_time();
+		const float elapsed_seconds = (sample_time - start) * 1.e-6f;
+		const float signal = sinf(two_pi * elapsed_seconds / cycle_seconds);
+
+		for (unsigned sensor = 0; sensor < simulated_sensor_count; sensor++) {
+			auto &measurement = measurements[sensor];
+			measurement.timestamp_sample = sample_time;
+			measurement.temperature = 20.f + 10.f * sensor + 2.f * signal;
+			measurement.humidity = 40.f + 20.f * sensor + 5.f * signal;
+			measurement.timestamp = hrt_absolute_time();
+			orb_publish(ORB_ID(sensor_hygrometer), publishers[sensor], &measurement);
+		}
+
+		next_sample += sample_period_us;
+		const uint64_t now = hrt_absolute_time();
+
+		if (next_sample > now) {
+			px4_usleep(next_sample - now);
+
+		} else {
+			// Skip missed deadlines instead of producing a burst of catch-up samples.
+			next_sample = now;
+		}
+	}
+
+	for (auto publisher : publishers) {
+		orb_unadvertise(publisher);
+	}
+
+	PX4_INFO("synthetic hygrometers finished");
+	return 0;
+}
+
 int px4_mavlink_debug_main(int argc, char *argv[])
 {
+	if (argc > 1 && strcmp(argv[1], "hygrometer") == 0) {
+		return run_hygrometer(argc, argv);
+	}
+
 	printf("Hello Debug!\n");
 
 	/* advertise named debug value */
