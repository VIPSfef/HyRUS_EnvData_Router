# Package the compiler target, never the host CPU or its Intel/AMD vendor.
include(CheckCSourceCompiles)
check_c_source_compiles("\n#if !defined(__x86_64__) && !defined(_M_X64) && !defined(_M_AMD64)\n#error not x64\n#endif\ntypedef char require_64_bit_pointers[sizeof(void *) == 8 ? 1 : -1];\nint main(void) { return 0; }\n" TB_COMPILER_X64)
set(TB_TARGET_ARCH x64 CACHE STRING "Expected compiler target: x64 (Intel/AMD x86-64)")
set_property(CACHE TB_TARGET_ARCH PROPERTY STRINGS x64)
if(NOT TB_TARGET_ARCH STREQUAL "x64")
  message(FATAL_ERROR "The supported target is x64. Intel x64 and AMD64 use the same target.")
endif()
if(NOT TB_COMPILER_X64 OR NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
  message(FATAL_ERROR "An x64 compiler target is required. Select VS -A x64 or an x86_64 GCC/Clang compiler in a separate build directory.")
endif()
message(STATUS "Telemetry target: ${CMAKE_SYSTEM_NAME}-x64 (8-byte pointers)")
if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
  add_compile_definitions(_FILE_OFFSET_BITS=64 _TIME_BITS=64)
endif()
