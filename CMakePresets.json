{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "MinSizeRel",
        "BUILD_TESTING": true,
        "TB_TARGET_ARCH": "x64"
      }
    },
    {
      "name": "windows-x64",
      "displayName": "Windows x64 send + monitor",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/windows-x64",
      "installDir": "${sourceDir}/build/stage/windows-x64",
      "cacheVariables": { "CMAKE_C_COMPILER": "clang" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "linux-x64",
      "displayName": "Linux x64 send + monitor",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/linux-x64",
      "installDir": "${sourceDir}/build/stage/linux-x64",
      "cacheVariables": { "CMAKE_C_COMPILER": "cc" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "windows-x64-debug",
      "displayName": "Windows x64 debug",
      "inherits": "windows-x64",
      "binaryDir": "${sourceDir}/build/windows-x64-debug",
      "installDir": "${sourceDir}/build/stage/windows-x64-debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "linux-x64-debug",
      "displayName": "Linux x64 debug",
      "inherits": "linux-x64",
      "binaryDir": "${sourceDir}/build/linux-x64-debug",
      "installDir": "${sourceDir}/build/stage/linux-x64-debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    }
  ],
  "buildPresets": [
    { "name": "windows-x64", "configurePreset": "windows-x64", "jobs": 2 },
    { "name": "linux-x64", "configurePreset": "linux-x64", "jobs": 2 },
    { "name": "windows-x64-debug", "configurePreset": "windows-x64-debug", "jobs": 2 },
    { "name": "linux-x64-debug", "configurePreset": "linux-x64-debug", "jobs": 2 },
    { "name": "package-windows-x64", "configurePreset": "windows-x64", "targets": ["package"], "jobs": 2 },
    { "name": "package-linux-x64", "configurePreset": "linux-x64", "targets": ["package"], "jobs": 2 }
  ],
  "testPresets": [
    { "name": "windows-x64", "configurePreset": "windows-x64", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } },
    { "name": "linux-x64", "configurePreset": "linux-x64", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } },
    { "name": "windows-x64-debug", "configurePreset": "windows-x64-debug", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } },
    { "name": "linux-x64-debug", "configurePreset": "linux-x64-debug", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } }
  ]
}
