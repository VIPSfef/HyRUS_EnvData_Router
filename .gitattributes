* text=auto
*.c text eol=lf
*.h text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.exe binary
*.zip binary
CMakeLists.txt text eol=lf
*.ini.example text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
*.cmake text eol=lf
*.json text eol=lf

# Keep vendored sources, schemas, and patch text byte-stable on Windows.
*.cpp text eol=lf
*.hpp text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.patch text eol=lf
Kconfig text eol=lf

# Unified-diff context intentionally begins with a space before tabs/blanks.
*.patch whitespace=-blank-at-eol,-space-before-tab,-blank-at-eof
